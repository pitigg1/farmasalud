# Copia este archivo como .env (en la misma carpeta) y completa los valores.
# El archivo .env no se sube a Git.

# Clave para firmar las sesiones (JWT): mínimo 32 caracteres. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Si la dejas vacía, la API usa una clave temporal y las sesiones se cierran al reiniciarla.
JWT_SECRET=

# Opcional: contraseña inicial para TODAS las cuentas precargadas (mínimo 8 caracteres).
# Solo se usa la primera vez, sobre una base nueva. Si la dejas vacía se usan las
# contraseñas fijas del README: Admin2026*, Empleado2026*, Cliente2026*.
CLAVE_INICIAL=

# --- Integración con otras UDS ---
# Nombre con el que nos identificamos ante otras UDS.
UDS_NOMBRE=FarmaSalud
# Claves que otras UDS deben enviar en la cabecera X-API-Key (separadas por comas). Vacía = API abierta.
UDS_API_KEYS=
# Otras UDS que el administrador puede consultar (JSON en una sola línea):
# UDS_EXTERNAS=[{"nombre":"drogueria-norte","url":"https://otra-uds.com/api/productos","api_key":"su-clave"}]
UDS_EXTERNAS=

# --- Supabase (solo en producción) ---
# DATABASE_URL=postgresql://postgres.<proyecto>:<clave>@aws-0-<region>.pooler.supabase.com:5432/postgres
# SUPABASE_URL=https://<proyecto>.supabase.co
# SUPABASE_SERVICE_KEY=
# SUPABASE_BUCKET=medicamentos

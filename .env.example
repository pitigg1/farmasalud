# Copia este archivo como .env (en la misma carpeta) y completa los valores.
# El archivo .env no se sube a Git.

# Clave para firmar las sesiones (JWT): mínimo 32 caracteres. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Si la dejas vacía, la API usa una clave temporal y las sesiones se cierran al reiniciarla.
JWT_SECRET=

# Contraseña inicial de las cuentas precargadas (admin, empleado y cliente): mínimo 8
# caracteres. Solo se usa la primera vez, sobre una base nueva. Si la dejas vacía, la API
# genera una aleatoria y la muestra en su registro (docker compose logs api).
CLAVE_INICIAL=
